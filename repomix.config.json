{
  "output": {
    "removeComments": true,
    "removeEmptyLines": true,
    "compress": true,
    "showLineNumbers": false
  },
  "include": [
    "backend/src/**/*",
    "mobile/src/**/*",
    "mobile/App.tsx",
    "mobile/index.ts"
  ],
  "ignore": {
    "customPatterns": [
      "**/*lock*",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "Cargo.lock",
      "go.sum",
      "poetry.lock",
      "**/dist/**",
      "**/build/**",
      "**/.next/**",
      "**/.nuxt/**",
      "**/out/**",
      "**/*.min.*",
      "**/*.map",
      "**/*.test.*",
      "**/*.spec.*",
      "**/__tests__/**",
      "**/mocks/**",
      "**/test/**",
      "**/*.md",
      "**/docs/**",
      "**/public/**",
      "**/assets/**",
      "**/*.svg",
      "**/*.png",
      "**/*.jpg",
      "**/*.ico",
      "**/*.woff*",
      "**/*.ttf",
      "**/*.css",
      "**/*.scss",
      "**/*.less",
      "**/*.d.ts",
      "**/*.private.*",
      "**/.env*"
    ]
  }
}